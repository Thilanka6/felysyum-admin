# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php83” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect HTTP to HTTPS (Optional, remove if unwanted)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # If a directory is requested, try to serve index.html
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # If an exact file exists, serve it
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # If the request has an .html extension, externally redirect to the URL without .html (SEO friendly)
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /([^.]+\.)+html\ HTTP
  RewriteRule ^(.+)\.html$ /$1 [R=301,L]

  # If the base requested file exists with a .html extension, internally rewrite to it
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # If no matches, rewrite to Next.js custom 404 page if it exists
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/404.html -f
  RewriteRule ^(.*)$ /404.html [L]
</IfModule>

# Handle custom 404 page for Apache
ErrorDocument 404 /404.html

# --- SECURITY HEADERS ---
<IfModule mod_headers.c>
  # Clickjacking Protection
  Header set X-Frame-Options "SAMEORIGIN"
  
  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"
  
  # Cross-Site Scripting (XSS) Protection
  Header set X-XSS-Protection "1; mode=block"
  
  # Referrer Policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  
  # Enforce HTTPS (HSTS)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  
  # Content Security Policy (Basic setup, uncomment and adjust if needed)
  # Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://felysyum.cloud"
</IfModule>
